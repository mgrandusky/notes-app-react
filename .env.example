# JWT Secrets - Generate strong random strings for production
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters-change-this
JWT_REFRESH_SECRET=your-secure-refresh-secret-minimum-32-characters-change-this
SESSION_SECRET=your-secure-session-secret-minimum-32-characters-change-this

# OpenAI API Key (for AI features)
OPENAI_API_KEY=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (configured in docker-compose.yml)
DATABASE_URL=postgresql://user:password@postgres:5432/notesapp

# Frontend URL
FRONTEND_URL=http://localhost:5173
